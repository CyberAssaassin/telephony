[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5070

[100]
type=endpoint
context=internal
disallow=all
allow=ulaw
auth=100
aors=100

[100]
type=auth
auth_type=userpass
username=100
password=CHANGE_ME

[100]
type=aor
max_contacts=1

[101]
type=endpoint
context=internal
disallow=all
allow=ulaw
auth=101
aors=101

[101]
type=auth
auth_type=userpass
username=101
password=CHANGE_ME

[101]
type=aor
max_contacts=1
